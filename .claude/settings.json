{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(bun run *)",
      "Bash(bun dev*)",
      "Bash(bun build*)",
      "Bash(bunx drizzle-kit *)",
      "Bash(bunx wrangler *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git push*)",
      "Bash(git pull*)"
    ],
    "deny": [
      "Bash(wrangler secret *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/scripts/format-edited.ts\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

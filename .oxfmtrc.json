{
  "singleQuote": true,
  "semi": false,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "ignorePatterns": [
    ".nuxt/**",
    ".output/**",
    ".data/**",
    ".wrangler/**",
    "dist/**",
    "node_modules/**",
    ".agents/**",
    ".claude/**",
    ".github/**",
    "docs/**",
    "server/db/migrations/**",
    "server/emails/generated.ts",
    "emails/theme.generated.css",
    "emails/.maizzle/**",
    "emails/**/*.vue",
    ".email-preview/**",
    "**/*.md",
    "**/*.json"

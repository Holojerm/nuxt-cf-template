{
  // Solution-style: no files of its own, only Nuxt's four generated projects. `nuxt typecheck`
  // runs `vue-tsc -b` over all of them only when this file has `files: []` and no `include`;
  // extending `.nuxt/tsconfig.json` instead checks app/ alone and skips server/ without a word
  // (.claude/docs/gotchas.md). Compiler options do not reach a referenced project from here:
  // set them in nuxt.config.ts › `typescript.tsConfig`.
  "files": [],
  "references": [
    { "path": "./.nuxt/tsconfig.app.json" },
    { "path": "./.nuxt/tsconfig.server.json" },
    { "path": "./.nuxt/tsconfig.shared.json" },
    { "path": "./.nuxt/tsconfig.node.json" }
  ]
}

# ─────────────────────────────────────────────
# Environment Variables
# Copy this file to .env and fill in values.
# .env is gitignored — never commit secrets.
# ─────────────────────────────────────────────

# Required: Random 32+ character string for sealing session cookies
# Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Required for deployment (also set as GitHub Actions secrets)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: Enables Claude Code's GitHub MCP server (repo read scope is sufficient)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: PostHog product analytics + session replay + exception tracking.
# Get the phc_… project key from: https://us.posthog.com/settings/project
# Set in nuxt.config.ts default OR override here in dev. Empty = disabled.
# NUXT_PUBLIC_POSTHOG_KEY=
# NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: Paddle billing (sandbox-first — create a sandbox account at
# https://sandbox-vendors.paddle.com). Client token: Developer tools →
# Authentication. Webhook secret: Developer tools → Notifications (point the
# destination at https://<your-app>/paddle/webhook). Empty = billing disabled.
# NUXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NUXT_PUBLIC_PADDLE_ENV=sandbox
# NUXT_PADDLE_WEBHOOK_SECRET=
# NUXT_PADDLE_API_KEY=

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Leave these empty to develop locally: /login offers a dev-only email sign-in
# (server/api/auth/dev.post.ts) that never ships to production. Fill them in
# when you want the real flow.
#
# GitHub:  Settings → Developer settings → OAuth Apps → New OAuth App
#          Authorization callback URL: https://<your-app>/api/auth/github
#          (locally: https://my-app.localhost/api/auth/github)
# NUXT_OAUTH_GITHUB_CLIENT_ID=
# NUXT_OAUTH_GITHUB_CLIENT_SECRET=
#
# Google:  console.cloud.google.com → APIs & Services → Credentials
#          Authorized redirect URI: https://<your-app>/api/auth/google
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# ── Public origin ────────────────────────────────────────────────────────────
# No trailing slash. Emails, sitemap.xml and og: tags build absolute links from
# this. Locally, match your portless host (https://my-app.localhost).
# NUXT_PUBLIC_APP_URL=http://localhost:3000

# ── Paddle price IDs (for /pricing) ──────────────────────────────────────────
# Sandbox and production issue different pri_… ids. An empty value disables that
# plan's button rather than opening a checkout that 400s.
# NUXT_PUBLIC_PADDLE_PRICE_MONTHLY=
# NUXT_PUBLIC_PADDLE_PRICE_YEARLY=
# NUXT_PUBLIC_PADDLE_PRICE_PASS=

# ── Transactional email (Resend) ─────────────────────────────────────────────
# Empty key = every send is a logged no-op, so sign-in and webhooks still work.
# `from` must be on a domain verified at resend.com/domains.
# NUXT_RESEND_API_KEY=
# NUXT_RESEND_FROM=My App <hello@example.com>

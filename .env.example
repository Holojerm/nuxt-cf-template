# ─────────────────────────────────────────────
# Environment Variables
# Copy this file to .env and fill in values.
# .env is gitignored — never commit secrets.
# ─────────────────────────────────────────────

# Required: Random 32+ character string for sealing session cookies
# Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Required for deployment (also set as GitHub Actions secrets)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: Enables Claude Code's GitHub MCP server (repo read scope is sufficient)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: PostHog product analytics + session replay + exception tracking.
# Get the phc_… project key from: https://us.posthog.com/settings/project
# Set in nuxt.config.ts default OR override here in dev. Empty = disabled.
# NUXT_PUBLIC_POSTHOG_KEY=
# NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: Paddle billing (sandbox-first — create a sandbox account at
# https://sandbox-vendors.paddle.com). Client token: Developer tools →
# Authentication. Webhook secret: Developer tools → Notifications (point the
# destination at https://<your-app>/paddle/webhook). Empty = billing disabled.
# NUXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NUXT_PUBLIC_PADDLE_ENV=sandbox
# NUXT_PADDLE_WEBHOOK_SECRET=
# NUXT_PADDLE_API_KEY=

# ── Sign-in ──────────────────────────────────────────────────────────────────
# The PRIMARY sign-in path is the magic link, and it needs no OAuth provider at
# all — only the Resend keys further down, so that the email can actually be
# sent. In production, unset Resend keys mean the magic-link endpoint returns
# 503 rather than pretending it sent something.
#
# Leave everything in this section empty to develop locally. /login still works:
# with no Resend key the dev server logs the sign-in URL to its console, and
# there is a dev-only email sign-in (server/api/auth/dev.post.ts) that never
# ships to production.
#
# The OAuth providers below are conveniences on top of the magic link. Every one
# of them is optional, and an unconfigured one simply doesn't render a button.
#
# Apple:   developer.apple.com → Certificates, Identifiers & Profiles →
#          Identifiers → your Services ID → Sign in with Apple → Configure.
#          Return URL: https://<your-app>/api/auth/apple
#          Four values, not two: Apple has no static client secret — the server
#          signs a short-lived JWT from the .p8 key on every request.
#          CLIENT_ID is the Services ID (e.g. com.example.app.web), not the App
#          ID. PRIVATE_KEY is the whole .p8 file with real newlines written \n.
#          These are human-set secrets: `wrangler secret put` in production,
#          never wrangler.toml [vars].
# NUXT_OAUTH_APPLE_CLIENT_ID=
# NUXT_OAUTH_APPLE_TEAM_ID=
# NUXT_OAUTH_APPLE_KEY_ID=
# NUXT_OAUTH_APPLE_PRIVATE_KEY=
#
# Google:  console.cloud.google.com → APIs & Services → Credentials
#          Authorized redirect URI: https://<your-app>/api/auth/google
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
#
# GitHub:  OPTIONAL, and off by default — it is a developer credential, so it
#          only belongs on a sign-in page whose audience has GitHub accounts.
#          Configure it for a devtool fork; leave it unset for a consumer app,
#          where it renders last if enabled at all.
#          Settings → Developer settings → OAuth Apps → New OAuth App
#          Authorization callback URL: https://<your-app>/api/auth/github
#          (locally: https://my-app.localhost/api/auth/github)
# NUXT_OAUTH_GITHUB_CLIENT_ID=
# NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# ── Public origin ────────────────────────────────────────────────────────────
# No trailing slash. Emails, sitemap.xml and og: tags build absolute links from
# this. Locally, match your portless host (https://my-app.localhost).
# NUXT_PUBLIC_APP_URL=http://localhost:3000

# ── Paddle price IDs (for /pricing) ──────────────────────────────────────────
# Sandbox and production issue different pri_… ids. An empty value disables that
# plan's button rather than opening a checkout that 400s.
# NUXT_PUBLIC_PADDLE_PRICE_MONTHLY=
# NUXT_PUBLIC_PADDLE_PRICE_YEARLY=
# NUXT_PUBLIC_PADDLE_PRICE_PASS=

# ── Transactional email (Resend) ─────────────────────────────────────────────
# Empty key = every send is a logged no-op, so OAuth sign-in and webhooks still
# work. Magic-link sign-in is the exception, because there the email IS the
# flow: in dev the link is logged to the server console instead, and in
# production the request returns 503 rather than claiming to have sent one. Set
# these before you ship if email sign-in is your front door.
#
# Human-set secrets — get the key from resend.com/api-keys, and `from` must be
# on a domain verified at resend.com/domains.
# NUXT_RESEND_API_KEY=
# NUXT_RESEND_FROM=My App <hello@example.com>

# ─────────────────────────────────────────────
# Environment Variables
# Copy this file to .env and fill in values.
# .env is gitignored — never commit secrets.
# ─────────────────────────────────────────────

# Required: Random 32+ character string for sealing session cookies
# Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Required for deployment (also set as GitHub Actions secrets)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: Enables Claude Code's GitHub MCP server (repo read scope is sufficient)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: OAuth providers (add as needed)
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# NUXT_OAUTH_GITHUB_CLIENT_ID=
# NUXT_OAUTH_GITHUB_CLIENT_SECRET=
